generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Search {
  id          String    @id @default(cuid())
  name        String
  url         String    @unique
  isTracking  Boolean   @default(false)
  lastScraped DateTime?
  createdAt   DateTime  @default(now())

  // Nombre d'annonces annonce par Leboncoin au dernier passage : sert a savoir
  // combien de pages il faut couvrir pour qu'un scan soit reellement complet.
  lastTotal   Int?

  listings    Listing[]
  snapshots   DailySnapshot[]
  runs        ScanRun[]
}

model Listing {
  id        String   @id
  title     String
  price     Int
  location  String?
  zipcode   String?
  thumb     String?
  url       String?
  status    String   @default("active")

  // Metadonnees utiles a l'analyse "bonne affaire".
  isPro       Boolean   @default(false)
  hasShipping Boolean   @default(false)
  publishedAt DateTime?
  raw         String?   // JSON brut de l'annonce (attributs, body tronque)

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  soldAt    DateTime?
  daysToSell Int?
  missingCount Int @default(0)

  searchId  String
  search    Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)
  history   PriceHistory[]

  @@index([searchId, status])
  @@index([searchId, lastSeen])
}

model PriceHistory {
  id        String   @id @default(cuid())
  listingId String
  price     Int
  date      DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, date])
}

model DailySnapshot {
  id         String   @id @default(cuid())
  searchId   String
  date       DateTime @default(now())
  avgPrice   Int
  medPrice   Int      @default(0)
  minPrice   Int
  maxPrice   Int
  count      Int
  search     Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId, date])
}

/// Un passage de collecte. C'est la piece qui manquait : sans savoir si un scan
/// a reellement couvert tout le perimetre, on ne peut pas conclure qu'une
/// annonce absente est vendue plutot que reléguée en page 9.
model ScanRun {
  id         String    @id @default(cuid())
  searchId   String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  pagesSeen  Int       @default(0)
  adsSeen    Int       @default(0)
  total      Int?
  complete   Boolean   @default(false)
  note       String?
  search     Search    @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId, startedAt])
}
